---
import Container from '@components/common/Container.astro';
import Section from '@components/common/Section.astro';

import { spaServices } from '@data/services';
import { spaContent } from '@data/spa';

const currencyFormatter = new Intl.NumberFormat('es-MX', {
    style: 'currency',
    currency: 'MXN',
    maximumFractionDigits: 0
});
---

<Section id="services">
    <Container>
        <div class="section-heading">
            <span class="eyebrow">Nuestros tratamientos</span>

            <h2>{spaContent.services.title}</h2>

            <p>{spaContent.services.description}</p>
        </div>

        <div class="services-grid">
            {
                spaServices.map((service) => (
                    <article class="service-card">
                        {service.featured && (
                            <span class="featured">
                                Popular
                            </span>
                        )}

                        <h3>{service.name}</h3>

                        <p class="description">
                            {service.description}
                        </p>

                        <div class="service-details">
                            <span>
                                {service.durationMinutes} min
                            </span>

                            <strong>
                                {currencyFormatter.format(service.price)}
                            </strong>
                        </div>
                    </article>
                ))
            }
        </div>

        <p class="demo-note">
            Precios demostrativos. No corresponden a un
            establecimiento real.
        </p>
    </Container>
</Section>

<style>
    .section-heading {
        max-width: 680px;
        margin: 0 auto var(--space-12);
        text-align: center;
    }

    .eyebrow {
        display: block;
        margin-bottom: var(--space-4);
        color: var(--color-primary);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .section-heading h2 {
        font-size: clamp(2rem, 4vw, 3.25rem);
        font-weight: var(--font-weight-normal);
    }

    .section-heading p {
        color: var(--color-text-muted);
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-6);
    }

    .service-card {
        display: flex;
        flex-direction: column;
        gap: var(--space-4);
        min-width: 0;
        padding: var(--space-8);
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
    }

    .featured {
        align-self: flex-start;
        padding: var(--space-1) var(--space-3);
        color: #ffffff;
        background-color: var(--color-primary);
        border-radius: var(--radius-full);
        font-size: var(--font-size-sm);
    }

    .service-card h3 {
        margin: 0;
        font-size: var(--font-size-xl);
        font-weight: var(--font-weight-normal);
    }

    .description {
        flex: 1;
        color: var(--color-text-muted);
    }

    .service-details {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-4);
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-border);
    }

    .service-details strong {
        color: var(--color-primary);
        font-size: var(--font-size-lg);
        white-space: nowrap;
    }

    .demo-note {
        margin-top: var(--space-6);
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        text-align: center;
    }

    @media (max-width: 900px) {
        .services-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 600px) {
        .services-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .service-card {
            padding: var(--space-6);
        }
    }
</style>
