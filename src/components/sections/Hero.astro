---
import Button from '@components/common/Button.astro';
import Container from '@components/common/Container.astro';
import Section from '@components/common/Section.astro';

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
    title: string;
    description: string;
    primaryAction: {
        label: string;
        href: string;
    };
    image?: {
        src: ImageMetadata;
        alt: string;
    };
}

const {
    title,
    description,
    primaryAction,
    image
} = Astro.props;
---

<Section class="hero">
    <Container>
        <div class:list={['hero-content', { 'has-image': Boolean(image) }]}>
            <div class="hero-text">
                <h1>{title}</h1>

                <p>{description}</p>

                <div class="hero-actions">
                    <Button href={primaryAction.href}>
                        {primaryAction.label}
                    </Button>
                </div>
            </div>

            {
                image && (
                    <div class="hero-media">
                        <Image
                            src={image.src}
                            alt={image.alt}
                            layout="constrained"
                            width={720}
                            priority
                        />
                    </div>
                )
            }
        </div>
    </Container>
</Section>

<style>
    .hero-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: center;
        gap: var(--space-12);
    }

    .hero-content.has-image {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hero-text {
        max-width: 640px;
    }

    .hero-text h1 {
        max-width: 14ch;
        font-family: var(--font-family-heading);
        font-size: clamp(2.5rem, 5.5vw, 5rem);
        font-weight: var(--font-weight-normal);
        line-height: 1.1;
        letter-spacing: -0.025em;
    }

    .hero-text p {
        max-width: 52ch;
        color: var(--color-text-muted);
        font-size: var(--font-size-lg);
        line-height: 1.8;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-4);
    }

    .hero-media :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: var(--radius-lg);
    }

    @media (max-width: 767px) {
        .hero-text h1 {
            font-size: clamp(2.25rem, 9vw, 3.5rem);
        }

        .hero-text p {
            font-size: var(--font-size-base);
        }
        
        .hero-content.has-image {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
