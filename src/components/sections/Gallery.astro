---
import { Image } from 'astro:assets';

import Container from '@components/common/Container.astro';
import Section from '@components/common/Section.astro';

import { galleryImages, spaContent } from '@data/spa';
---

<Section id="gallery">
    <Container>
        <div class="gallery-heading">
            <h2>{spaContent.gallery.title}</h2>
            <p>{spaContent.gallery.description}</p>
        </div>

        {
            galleryImages.length > 0 ? (
                <div class="gallery-grid">
                    {galleryImages.map((image) => (
                        <figure class="gallery-item">
                            <Image
                                src={image.src}
                                alt={image.alt}
                                layout="constrained"
                                widths={[320, 480, 720]}
                                sizes="(max-width: 767px) 100vw, 33vw"
                                loading="lazy"
                            />
                        </figure>
                    ))}
                </div>
            ) : (
                <div class="gallery-placeholder">
                    <p>
                        Galería de demostración.
                        Las fotografías se incorporarán posteriormente.
                    </p>
                </div>
            )
        }
    </Container>
</Section>

<style>
    .gallery-heading {
        max-width: 680px;
        margin: 0 auto var(--space-12);
        text-align: center;
    }

    .gallery-heading h2 {
        font-size: clamp(2rem, 4vw, 3.25rem);
        font-weight: var(--font-weight-normal);
    }

    .gallery-heading p {
        color: var(--color-text-muted);
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--space-4);
    }

    .gallery-item {
        min-width: 0;
        margin: 0;
        overflow: hidden;
        border-radius: var(--radius-lg);
    }

    .gallery-item :global(img) {
        display: block;
        width: 100%;
        height: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
    }

    .gallery-placeholder {
        display: grid;
        place-items: center;
        min-height: 240px;
        padding: var(--space-8);
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        text-align: center;
    }

    .gallery-placeholder p {
        max-width: 40ch;
        margin: 0;
        color: var(--color-text-muted);
    }

    @media (max-width: 767px) {
        .gallery-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }
</style>
