---
import Container from '@components/common/Container.astro';
import Section from '@components/common/Section.astro';

import { bookingConfig } from '@config/booking';

function isGoogleCalendarUrl(value: string): boolean {
    if (!value) return false;

    try {
        const url = new URL(value);

        return (
            url.protocol === 'https:' &&
            (
                url.hostname === 'calendar.google.com' ||
                url.hostname === 'calendar.app.google'
            )
        );
    } catch {
        return false;
    }
}

const bookingUrl = bookingConfig.bookingUrl.trim();
const embedUrl = bookingConfig.embedUrl.trim();

const hasBookingLink =
    bookingConfig.enabled &&
    isGoogleCalendarUrl(bookingUrl);

const hasEmbed =
    hasBookingLink &&
    isGoogleCalendarUrl(embedUrl);

const showEmbed =
    hasEmbed &&
    bookingConfig.displayMode === 'embed';

const showPresentation = hasBookingLink;
---

<Section id="booking">
    <Container>
        <div class="booking-content">
            <span class="eyebrow">RESERVACIONES</span>

            <h2>
                Tu próximo momento de tranquilidad comienza aquí.
            </h2>

            <p class="intro">
                Consulta los horarios disponibles y selecciona
                el momento que mejor se adapte a ti.
            </p>

            {
                showEmbed && (
                    <div class="booking-calendar">
                        <iframe
                            src={embedUrl}
                            title="Agenda de reservaciones de Serenia Spa"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"
                        ></iframe>
                    </div>
                )
            }

            {
                showPresentation && (
                    <div class:list={[
                        'booking-card',
                        { 'mobile-only': showEmbed }
                    ]}>
                        <div class="card-decoration" aria-hidden="true">
                            <span class="decoration-line"></span>
                            <span class="decoration-circle"></span>
                            <span class="decoration-line"></span>
                        </div>

                        <span class="card-eyebrow">
                            TU EXPERIENCIA DE BIENESTAR
                        </span>

                        <h3>Un momento solo para ti.</h3>

                        <p class="card-description">
                            Descubre nuestros cinco tratamientos
                            y encuentra el horario ideal para
                            tu próxima sesión.
                        </p>

                        <div class="booking-details">
                            <div class="detail">
                                <span class="detail-title">
                                    Tratamientos
                                </span>

                                <span class="detail-value">
                                    5 experiencias disponibles
                                </span>
                            </div>

                            <div class="detail">
                                <span class="detail-title">
                                    Reservaciones
                                </span>

                                <span class="detail-value">
                                    Disponibilidad en tiempo real
                                    mediante Google Calendar
                                </span>
                            </div>
                        </div>

                        <a
                            class="booking-link"
                            href={bookingUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            Consultar disponibilidad y reservar
                            <span aria-hidden="true">↗</span>
                        </a>

                        <p class="booking-note">
                            La reservación se completa en
                            Google Calendar.
                        </p>
                    </div>
                )
            }

            {
                showEmbed && (
                    <a
                        class="booking-link embed-fallback desktop-only"
                        href={bookingUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Abrir agenda de reservaciones
                        <span aria-hidden="true">↗</span>
                    </a>
                )
            }

            {
                !hasBookingLink && (
                    <div class="booking-placeholder">
                        <p>
                            Esta es una demostración de Serenia Spa.
                            Las reservaciones se habilitarán
                            cuando se configure una agenda.
                        </p>
                    </div>
                )
            }
        </div>
    </Container>
</Section>

<style>
    .booking-content {
        max-width: 1000px;
        margin-inline: auto;
        text-align: center;
    }

    .eyebrow,
    .card-eyebrow {
        display: block;
        color: var(--color-primary);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
        letter-spacing: 0.12em;
    }

    .eyebrow {
        margin-bottom: var(--space-4);
    }

    .booking-content h2 {
        max-width: 18ch;
        margin: 0 auto var(--space-6);
        font-size: clamp(2rem, 4vw, 3.25rem);
        font-weight: var(--font-weight-normal);
        line-height: 1.2;
    }

    .intro {
        max-width: 55ch;
        margin: 0 auto var(--space-8);
        color: var(--color-text-muted);
    }

    /* Variante A: Google Calendar integrado */

    .booking-calendar {
        margin-bottom: var(--space-6);
        overflow: hidden;
        background-color: #ffffff;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
    }

    .booking-calendar iframe {
        display: block;
        width: 100%;
        min-height: 680px;
        border: 0;
    }

    /* Variante C: presentación Serenia */

    .booking-card {
        max-width: 720px;
        margin-inline: auto;
        padding: clamp(1.5rem, 5vw, 3.5rem);
        background-color: #ffffff;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: 0 14px 45px rgb(64 59 53 / 6%);
    }

    .booking-card.mobile-only {
        display: none;
    }

    .card-decoration {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: var(--space-3);
        margin-bottom: var(--space-6);
    }

    .decoration-line {
        width: 36px;
        height: 1px;
        background-color: var(--color-accent);
    }

    .decoration-circle {
        width: 12px;
        height: 12px;
        border: 2px solid var(--color-primary);
        border-radius: 50%;
    }

    .card-eyebrow {
        font-size: 0.75rem;
    }

    .booking-card h3 {
        margin: var(--space-4) 0;
        font-family: var(--font-family-heading);
        font-size: clamp(1.75rem, 4vw, 2.75rem);
        font-weight: var(--font-weight-normal);
    }

    .card-description {
        max-width: 45ch;
        margin: 0 auto var(--space-8);
        color: var(--color-text-muted);
        line-height: 1.7;
    }

    .booking-details {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-4);
        margin-bottom: var(--space-8);
        text-align: left;
    }

    .detail {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-4);
        background-color: var(--color-background);
        border-radius: var(--radius-md);
    }

    .detail-title {
        color: var(--color-primary);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-semibold);
    }

    .detail-value {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
    }

    .booking-link {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: var(--space-3);
        padding: var(--space-4) var(--space-6);
        color: #ffffff;
        background-color: var(--color-primary);
        border-radius: var(--radius-md);
        font-weight: var(--font-weight-semibold);
        text-decoration: none;
        transition: background-color 0.2s ease;
    }

    .booking-link:hover {
        background-color: var(--color-primary-hover);
    }

    .booking-link:focus-visible {
        outline: 3px solid var(--focus-color);
        outline-offset: 4px;
    }

    .embed-fallback {
        margin-top: var(--space-4);
    }

    .booking-note {
        margin: var(--space-4) 0 0;
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
    }

    .booking-placeholder {
        max-width: 680px;
        margin-inline: auto;
        padding: var(--space-8);
        background-color: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
    }

    .booking-placeholder p {
        margin: 0;
        color: var(--color-text-muted);
    }

    @media (max-width: 767px) {
        .booking-calendar {
            display: none;
        }

        .booking-card.mobile-only {
            display: block;
        }

        .desktop-only {
            display: none;
        }

        .booking-details {
            grid-template-columns: minmax(0, 1fr);
        }

        .booking-link {
            width: 100%;
        }
    }

    @media (max-width: 600px) {
        .booking-details {
            grid-template-columns: minmax(0, 1fr);
        }

        .booking-link {
            width: 100%;
        }

        .booking-calendar iframe {
            min-height: 600px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .booking-link {
            transition: none;
        }
    }
</style>
